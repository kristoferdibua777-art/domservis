<div class="dom-servis-dispatch-admin">
  <div class="dom-servis-dispatch-admin__header">
    <div>
      <h1><%- @T('Dispatch Admin') %></h1>
      <p><%- @T('Board behavior matrix for the Dom-Servis dispatch workspace. Assign people to roles in Manage > Roles; configure how those roles act on jobs here.') %></p>
    </div>
    <div class="dom-servis-dispatch-admin__actions">
      <button class="btn js-refresh-dispatch-admin"><%- @T('Refresh') %></button>
      <button class="btn js-reset-dispatch-policy"><%- @T('Reset defaults') %></button>
      <button class="btn btn--primary js-save-dispatch-policy"<%= ' disabled' if !@dirty || @saving %>><%- @T('Save policy') %></button>
      <button class="btn btn--success js-open-dispatch-board"><%- @T('Open Dispatch Board') %></button>
    </div>
  </div>

  <% if @error: %>
    <div class="alert alert-danger"><%= @error %></div>
  <% end %>

  <div class="dom-servis-dispatch-admin__cards">
    <div class="dom-servis-dispatch-admin-card">
      <span><%- @T('Total jobs') %></span>
      <strong><%= @stats.total %></strong>
    </div>
    <div class="dom-servis-dispatch-admin-card">
      <span><%- @T('Pool') %></span>
      <strong><%= @stats.pool %></strong>
    </div>
    <div class="dom-servis-dispatch-admin-card">
      <span><%- @T('Active') %></span>
      <strong><%= @stats.active %></strong>
    </div>
    <div class="dom-servis-dispatch-admin-card">
      <span><%- @T('Done') %></span>
      <strong><%= @stats.done %></strong>
    </div>
    <% if @stats.ticket_sync_failed > 0: %>
      <div class="dom-servis-dispatch-admin-card" title="Изменения этих заявок не дошли до тикетов Zammad. Повторить синхронизацию можно в карточке заявки на доске.">
        <span>Тикет не обновлён</span>
        <strong><%= @stats.ticket_sync_failed %></strong>
      </div>
    <% end %>
  </div>

  <div class="dom-servis-dispatch-admin__note">
    <% if @loading: %>
      <div class="spinner spinner--small"></div>
      <span><%- @T('Loading dispatch registry and current policy…') %></span>
    <% else: %>
      <p><%- @T('This screen is the workflow policy layer of Dom-Servis. It does not replace Zammad role assignment.') %></p>
      <p><%- @T('Use it to define which role may press which button, set which status and edit which field on the dispatch board.') %></p>
      <% if @dirty: %>
        <p><strong><%- @T('Unsaved changes:') %></strong> <%- @T('the matrix below has been edited and is not saved yet.') %></p>
      <% end %>
    <% end %>
  </div>

  <% if !@loading: %>
    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2>История заявок</h2>
          <p>История каждой заявки хранится, в том числе после удаления заявки. Раз в 30 дней выгружайте её в Excel: сразу после скачивания файла появится запрос на удаление выгруженных событий.</p>
        </div>
      </div>

      <div class="dom-servis-dispatch-admin__settings-card">
        <% if @history: %>
          <% if @history.due: %>
            <div class="alert alert-warning">С прошлой выгрузки прошло больше <%= @history.reminderDays %> дней — выгрузите историю заявок.</div>
          <% end %>
          <p>Событий в истории: <strong><%= @history.eventCount %></strong></p>
          <% if @history.lastExport: %>
            <p class="dom-servis-dispatch-admin__setting-hint">
              Последняя выгрузка: <%= @history.lastExport.createdAt %>, <%= @history.lastExport.createdBy %>, событий: <%= @history.lastExport.eventCount %>.
              <% if @history.lastExport.purgedAt: %>
                Удалено событий: <%= @history.lastExport.purgedCount %> (<%= @history.lastExport.purgedAt %>, <%= @history.lastExport.purgedBy %>).
              <% else if !@history.lastExport.downloaded: %>
                Файл не был скачан.
              <% else: %>
                Выгруженные события ещё не удалены.
              <% end %>
            </p>
          <% else: %>
            <p class="dom-servis-dispatch-admin__setting-hint">Выгрузок ещё не было.</p>
          <% end %>
        <% end %>

        <div class="dom-servis-dispatch-admin__actions">
          <button class="btn btn--primary js-history-export"<%= ' disabled' if !@history || @history.busy || @history.eventCount is 0 %>>Выгрузить историю в Excel</button>
          <% if @history?.lastExport?.purgeable: %>
            <button class="btn btn--danger js-history-purge"<%= ' disabled' if @history.busy %>>Удалить выгруженную историю</button>
          <% end %>
        </div>
      </div>
    </section>

    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2>Прайс для отчётов мастеров</h2>
          <p>Мастер выбирает работы и запчасти из прайса, цена подставляется сама и её можно изменить в отчёте — изменённая цена видна в отчёте и в выгрузке. Направление ограничивает строку заявками с таким тегом; без направления строка общая.</p>
        </div>
      </div>

      <div class="dom-servis-dispatch-admin__settings-card">
        <% if !@finance.priceLoaded: %>
          <p class="dom-servis-dispatch-admin__setting-hint">Загрузка прайса…</p>
        <% else: %>
          <% if @finance.items.length < 1: %>
            <p class="dom-servis-dispatch-admin__setting-hint">Прайс пуст. Добавьте строки или типовые позиции и укажите цены.</p>
          <% else: %>
            <div class="dom-servis-dispatch-admin__table-wrap">
              <table class="dom-servis-dispatch-admin__table">
                <thead>
                  <tr>
                    <th>Наименование</th>
                    <th>Тип</th>
                    <th>Направление</th>
                    <th>Ед.</th>
                    <th>Цена, ₽</th>
                    <th>Активна</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% for item in @finance.items: %>
                    <tr>
                      <td><input class="form-control js-price-field" data-index="<%= item.index %>" data-field="name" type="text" value="<%= item.name %>"></td>
                      <td>
                        <select class="form-control js-price-field" data-index="<%= item.index %>" data-field="kind">
                          <% for kind in @finance.kinds: %>
                            <option value="<%= kind.id %>"<%= ' selected' if item.kind is kind.id %>><%= kind.label %></option>
                          <% end %>
                        </select>
                      </td>
                      <td>
                        <select class="form-control js-price-field" data-index="<%= item.index %>" data-field="direction">
                          <option value="">Все направления</option>
                          <% for direction in @finance.directions: %>
                            <option value="<%= direction %>"<%= ' selected' if item.direction is direction %>><%= direction %></option>
                          <% end %>
                        </select>
                      </td>
                      <td><input class="form-control js-price-field" data-index="<%= item.index %>" data-field="unit" type="text" value="<%= item.unit %>"></td>
                      <td><input class="form-control js-price-field" data-index="<%= item.index %>" data-field="price" type="text" inputmode="decimal" value="<%= item.price %>"></td>
                      <td><input class="js-price-field" data-index="<%= item.index %>" data-field="active" type="checkbox"<%= ' checked' if item.active %>></td>
                      <td><button class="btn btn--text js-price-remove" data-index="<%= item.index %>" aria-label="Убрать строку">✕</button></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>

          <div class="dom-servis-dispatch-admin__actions">
            <button class="btn js-price-add">Добавить строку</button>
            <button class="btn js-price-template">Добавить типовые позиции</button>
            <button class="btn btn--primary js-price-save"<%= ' disabled' if @finance.busy %>>Сохранить прайс</button>
          </div>
        <% end %>
      </div>
    </section>

    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2>Проценты мастеров и партнёров</h2>
          <p>Мастер получает свой процент от суммы работ, запчасти, которые он купил, возвращаются ему полностью. Партнёр (организация заявки) получает процент от работ или от всей суммы. Отчёты незакрытых заявок пересчитываются по текущим процентам, закрытые сохраняют свои.</p>
        </div>
      </div>

      <div class="dom-servis-dispatch-admin__settings-card">
        <% if !@finance.ratesLoaded: %>
          <p class="dom-servis-dispatch-admin__setting-hint">Загрузка процентов…</p>
        <% else: %>
          <div class="dom-servis-dispatch-admin__table-wrap">
            <table class="dom-servis-dispatch-admin__table">
              <thead>
                <tr><th>Мастер</th><th>Процент от работ</th></tr>
              </thead>
              <tbody>
                <% for row in @finance.masters: %>
                  <tr>
                    <td><%= row.name %></td>
                    <td><input class="form-control js-rate-field" data-type="master" data-index="<%= row.index %>" data-field="work_percent" type="text" inputmode="decimal" value="<%= row.work_percent %>"></td>
                  </tr>
                <% end %>
                <% if @finance.masters.length < 1: %>
                  <tr><td colspan="2">Мастеров нет — дайте сотрудникам роль Dom-Servis Master.</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="dom-servis-dispatch-admin__table-wrap">
            <table class="dom-servis-dispatch-admin__table">
              <thead>
                <tr><th>Партнёр (организация)</th><th>Процент</th><th>От чего</th></tr>
              </thead>
              <tbody>
                <% for row in @finance.partners: %>
                  <tr>
                    <td><%= row.name %></td>
                    <td><input class="form-control js-rate-field" data-type="partner" data-index="<%= row.index %>" data-field="percent" type="text" inputmode="decimal" value="<%= row.percent %>"></td>
                    <td>
                      <select class="form-control js-rate-field" data-type="partner" data-index="<%= row.index %>" data-field="base">
                        <% for base in @finance.bases: %>
                          <option value="<%= base.id %>"<%= ' selected' if row.base is base.id %>><%= base.label %></option>
                        <% end %>
                      </select>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="dom-servis-dispatch-admin__actions">
            <button class="btn btn--primary js-rates-save"<%= ' disabled' if @finance.busy %>>Сохранить проценты</button>
          </div>
        <% end %>
      </div>
    </section>

    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2>Таблица заявок и отчётов</h2>
          <p>Excel за период: лист «Заявки» — все поля заявки и кратко её отчёт с суммами, оплатой и долями; «Позиции» — каждая работа и запчасть; «Мастера», «Партнёры», «Направления» — итоги калькулятора по сданным отчётам.</p>
        </div>
      </div>

      <div class="dom-servis-dispatch-admin__settings-card">
        <div class="dom-servis-dispatch-admin__export-fields">
          <div class="form-group">
            <label>С</label>
            <input class="form-control js-report-export-field" data-field="from" type="date" value="<%= @reportExport.from %>">
          </div>
          <div class="form-group">
            <label>По</label>
            <input class="form-control js-report-export-field" data-field="to" type="date" value="<%= @reportExport.to %>">
          </div>
          <div class="form-group">
            <label>Заявки</label>
            <select class="form-control js-report-export-field" data-field="date_field">
              <option value="created"<%= ' selected' if @reportExport.date_field is 'created' %>>созданные в эти дни</option>
              <option value="completed"<%= ' selected' if @reportExport.date_field is 'completed' %>>выполненные в эти дни</option>
            </select>
          </div>
          <div class="form-group">
            <label>Мастер</label>
            <select class="form-control js-report-export-field" data-field="master_id">
              <option value="">Все мастера</option>
              <% for row in @finance.masters: %>
                <option value="<%= row.user_id %>"<%= ' selected' if "#{@reportExport.master_id}" is "#{row.user_id}" %>><%= row.name %></option>
              <% end %>
            </select>
          </div>
        </div>
        <div class="dom-servis-dispatch-admin__actions">
          <button class="btn btn--primary js-report-export-download"<%= ' disabled' if @reportExport.busy %>><%= if @reportExport.busy then 'Готовлю файл…' else 'Скачать Excel' %></button>
        </div>
      </div>
    </section>

    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2>ИИ-разбор текста заявок (GigaChat или YandexGPT)</h2>
          <p>Диспетчер вставляет в форму новой заявки сообщение клиента — из WhatsApp, Telegram, Авито, СМС или почты, — и поля заполняются сами. Без ИИ текст разбирается по правилам; с ИИ разбор точнее. Телефон и адрес от ИИ подставляются, только если они есть в тексте. Заявку всегда создаёт человек.</p>
        </div>
      </div>

      <div class="dom-servis-dispatch-admin__settings-card">
        <% if !@ai.loaded: %>
          <p class="dom-servis-dispatch-admin__setting-hint">Загрузка настроек…</p>
        <% else: %>
          <div class="form-group dom-servis-dispatch-admin__setting">
            <label>
              <input type="checkbox" class="js-ai-enabled"<%= ' checked' if @ai.enabled %><%= ' disabled' if !@ai.authKeySet %>>
              Разбирать текст через ИИ
            </label>
            <% if !@ai.authKeySet: %>
              <p class="dom-servis-dispatch-admin__setting-hint">Сначала сохраните ключ.</p>
            <% end %>
          </div>

          <div class="form-group dom-servis-dispatch-admin__setting">
            <label for="dom-servis-ai-provider">Способ подключения</label>
            <select id="dom-servis-ai-provider" class="form-control js-ai-provider">
              <% for provider in @ai.providerOptions: %>
                <option value="<%= provider.id %>"<%= ' selected' if provider.id is @ai.provider %>><%= provider.label %></option>
              <% end %>
            </select>
            <p class="dom-servis-dispatch-admin__setting-hint">Новым пользователям GigaChat API Сбера даёт бесплатный пакет Freemium. С 1 сентября 2026 года платный доступ к GigaChat для новых клиентов — через Cloud.ru Foundation Models. YandexGPT работает без сертификата Минцифры, оплата — по факту в Yandex Cloud.</p>
          </div>

          <div class="form-group dom-servis-dispatch-admin__setting">
            <label for="dom-servis-ai-auth-key"><%= if @ai.provider is 'gigachat' then 'Ключ авторизации' else 'API-ключ' %></label>
            <input id="dom-servis-ai-auth-key" class="form-control js-ai-auth-key" type="password" autocomplete="off" spellcheck="false" placeholder="<%= if @ai.authKeySet then 'Ключ сохранён — вставьте новый, чтобы заменить' else 'Ключ из личного кабинета' %>">
            <p class="dom-servis-dispatch-admin__setting-hint">Ключ хранится только на сервере и больше нигде не показывается.</p>
          </div>

          <% if @ai.provider is 'chat_completions': %>
            <div class="form-group dom-servis-dispatch-admin__setting">
              <label for="dom-servis-ai-base-url">Адрес API</label>
              <input id="dom-servis-ai-base-url" class="form-control js-ai-base-url" type="url" value="<%= @ai.baseUrl %>">
              <p class="dom-servis-dispatch-admin__setting-hint">Для Cloud.ru — https://foundation-models.api.cloud.ru/v1. Название модели возьмите из списка, который покажет «Проверить подключение».</p>
            </div>
          <% else if @ai.provider is 'yandex': %>
            <div class="form-group dom-servis-dispatch-admin__setting">
              <label for="dom-servis-ai-folder-id">ID каталога Yandex Cloud</label>
              <input id="dom-servis-ai-folder-id" class="form-control js-ai-folder-id" type="text" autocomplete="off" spellcheck="false" placeholder="b1g…" value="<%= @ai.folderId %>">
              <p class="dom-servis-dispatch-admin__setting-hint">Каталог, в котором создан сервисный аккаунт с ролью ai.languageModels.user. Его ID — на странице каталога в консоли Yandex Cloud.</p>
            </div>
          <% else: %>
            <div class="form-group dom-servis-dispatch-admin__setting">
              <label for="dom-servis-ai-scope">Тип доступа</label>
              <select id="dom-servis-ai-scope" class="form-control js-ai-scope">
                <% for scope in @ai.scopeOptions: %>
                  <option value="<%= scope.id %>"<%= ' selected' if scope.id is @ai.scope %>><%= scope.label %></option>
                <% end %>
              </select>
            </div>
          <% end %>

          <div class="form-group dom-servis-dispatch-admin__setting">
            <label for="dom-servis-ai-model">Модель</label>
            <input id="dom-servis-ai-model" class="form-control js-ai-model" type="text" list="dom-servis-ai-models" value="<%= @ai.model %>">
            <datalist id="dom-servis-ai-models">
              <% for model in @ai.models: %>
                <option value="<%= model %>"></option>
              <% end %>
            </datalist>
            <% if @ai.provider is 'gigachat': %>
              <p class="dom-servis-dispatch-admin__setting-hint">GigaChat-2 — дешевле, GigaChat-2-Pro — точнее (рекомендуется), GigaChat-2-Max — самая сильная.</p>
            <% else if @ai.provider is 'yandex': %>
              <p class="dom-servis-dispatch-admin__setting-hint">yandexgpt/latest — YandexGPT Pro, точнее (рекомендуется); yandexgpt-lite/latest — дешевле; yandexgpt/rc — новая версия Pro. Можно вставить и полный адрес модели gpt://….</p>
            <% end %>
          </div>

          <% if @ai.provider is 'gigachat': %>
            <p class="dom-servis-dispatch-admin__setting-hint">GigaChat работает с сертификатом Минцифры: один раз загрузите корневой сертификат Russian Trusted Root CA в Управление → Безопасность → SSL-сертификаты.</p>
          <% end %>

          <% if @ai.check: %>
            <% if @ai.check.ok: %>
              <div class="alert alert-success">
                Подключение работает.
                <% if @ai.check.sample: %>Пробный разбор: <%= @ai.check.sample %>.<% end %>
                <% if @ai.check.models.length > 0: %>Доступные модели: <%= @ai.check.models.join(', ') %>.<% end %>
                <% if @ai.check.models.length > 0 && !@ai.check.modelAvailable: %> Выбранной модели в этом списке нет — выберите модель из списка.<% end %>
              </div>
            <% else: %>
              <div class="alert alert-danger"><%= @ai.check.error %></div>
            <% end %>
          <% end %>

          <div class="dom-servis-dispatch-admin__actions">
            <button class="btn btn--primary js-ai-save"<%= ' disabled' if @ai.busy %>>Сохранить</button>
            <button class="btn js-ai-check"<%= ' disabled' if @ai.busy || !@ai.authKeySet %>>Проверить подключение</button>
            <% if @ai.authKeySet: %>
              <button class="btn btn--danger js-ai-clear-key"<%= ' disabled' if @ai.busy %>>Удалить ключ</button>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2><%- @T('Deadline warning') %></h2>
          <p><%- @T('Set how many minutes before the visit deadline a pool job should turn red on the board.') %></p>
        </div>
      </div>

      <div class="dom-servis-dispatch-admin__settings-card">
        <div class="form-group dom-servis-dispatch-admin__setting">
          <label><%- @T('Minutes before deadline') %></label>
          <input
            class="form-control js-policy-setting"
            type="number"
            min="1"
            step="5"
            data-setting="deadline_warning_minutes"
            value="<%= @policy.settings.deadline_warning_minutes %>">
          <p class="dom-servis-dispatch-admin__setting-hint"><%- @T('Recommended default: 120 minutes. Used only for the board highlight, not for status transitions.') %></p>
        </div>
      </div>
    </section>

    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2><%- @T('Dispatcher calendar') %></h2>
          <p><%- @T('Set the visit length and the hours the dispatcher calendar shows (by default 120 minutes, from 8 to 20). Jobs outside these hours are listed under the grid.') %></p>
        </div>
      </div>

      <div class="dom-servis-dispatch-admin__settings-card">
        <div class="form-group dom-servis-dispatch-admin__setting">
          <label><%- @T('Visit length in minutes') %></label>
          <input
            class="form-control js-policy-setting"
            type="number"
            min="15"
            max="720"
            step="15"
            data-setting="visit_duration_minutes"
            value="<%= @policy.settings.visit_duration_minutes %>">
          <p class="dom-servis-dispatch-admin__setting-hint"><%- @T('How long a visit with an exact start time but no end lasts in the dispatcher calendar.') %></p>
        </div>
      </div>

      <div class="dom-servis-dispatch-admin__settings-card">
        <div class="form-group dom-servis-dispatch-admin__setting">
          <label><%- @T('Calendar day starts at (hour)') %></label>
          <input
            class="form-control js-policy-setting"
            type="number"
            min="0"
            max="23"
            step="1"
            data-setting="calendar_day_start_hour"
            value="<%= @policy.settings.calendar_day_start_hour %>">
          <p class="dom-servis-dispatch-admin__setting-hint"><%- @T('First hour shown in the dispatcher calendar.') %></p>
        </div>
      </div>

      <div class="dom-servis-dispatch-admin__settings-card">
        <div class="form-group dom-servis-dispatch-admin__setting">
          <label><%- @T('Calendar day ends at (hour)') %></label>
          <input
            class="form-control js-policy-setting"
            type="number"
            min="1"
            max="24"
            step="1"
            data-setting="calendar_day_end_hour"
            value="<%= @policy.settings.calendar_day_end_hour %>">
          <p class="dom-servis-dispatch-admin__setting-hint"><%- @T('Last hour shown in the dispatcher calendar. Must be later than the start.') %></p>
        </div>
      </div>
    </section>

    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2><%- @T('Dispatch Tags') %></h2>
          <p><%- @T('Dispatch job tags reuse the global Zammad tag namespace. Create new tag names only in Manage > Tags, then dispatchers can assign them on jobs and the same tags will be mirrored into backing tickets.') %></p>
        </div>
      </div>

      <% if @tags.length > 0: %>
        <div class="dom-servis-dispatch-admin__tag-list">
          <% for tag in @tags: %>
            <div class="dom-servis-dispatch-admin__tag-card">
              <strong><%= tag.name %></strong>
              <span><%- @T('Dispatch jobs') %>: <%= tag.dispatch_count %></span>
              <span><%- @T('All Zammad references') %>: <%= tag.ticket_count %></span>
            </div>
          <% end %>
        </div>
      <% else: %>
        <div class="dom-servis-dispatch-admin__tag-empty"><%- @T('No dispatch tags created yet.') %></div>
      <% end %>

      <div class="dom-servis-dispatch-admin__note">
        <p><%- @T('Dispatch Admin is read-only for the tag dictionary. Use Manage > Tags to create or rename tags, and use the dispatch board to assign them on jobs.') %></p>
      </div>
    </section>

    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2><%- @T('Role Profiles') %></h2>
          <p><%- @T('Stable role stack. Membership is assigned in Zammad roles; behavior is configured by the matrices below.') %></p>
        </div>
      </div>

      <div class="dom-servis-dispatch-admin__role-grid">
        <% for role in @registry.roles: %>
          <article class="dom-servis-dispatch-admin__role-card">
            <div class="dom-servis-dispatch-admin__role-title"><%- @T(role.label) %></div>
            <div class="dom-servis-dispatch-admin__role-line"><span><%- @T('Base role') %></span><strong><%= role.base_role %></strong></div>
            <div class="dom-servis-dispatch-admin__role-line"><span><%- @T('Overlay role') %></span><strong><%= role.overlay_role %></strong></div>
            <div class="dom-servis-dispatch-admin__role-line"><span><%- @T('Permission') %></span><strong><%= role.permission %></strong></div>
            <p><%- @T(role.description) %></p>
          </article>
        <% end %>
      </div>
    </section>

    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2><%- @T('Actions Matrix') %></h2>
          <p><%- @T('Every current and planned board action gets an explicit per-role toggle.') %></p>
        </div>
      </div>

      <% for group in @registry.action_groups: %>
        <div class="dom-servis-dispatch-admin__matrix-block">
          <div class="dom-servis-dispatch-admin__matrix-title"><%- @T(group.label) %></div>
          <table class="dom-servis-dispatch-admin__matrix-table">
            <thead>
              <tr>
                <th><%- @T('Action') %></th>
                <th><%- @T('Master') %></th>
                <th><%- @T('Dispatcher') %></th>
                <th><%- @T('Admin') %></th>
              </tr>
            </thead>
            <tbody>
              <% for item in group.items: %>
                <tr>
                  <td>
                    <div class="dom-servis-dispatch-admin__cell-title"><%- @T(item.label) %></div>
                    <div class="dom-servis-dispatch-admin__cell-hint"><%- @T(item.description) %></div>
                  </td>
                  <% for role in @registry.roles: %>
                    <td class="dom-servis-dispatch-admin__toggle-cell">
                      <label class="dom-servis-dispatch-admin__toggle">
                        <input
                          class="js-policy-toggle"
                          type="checkbox"
                          data-section="actions"
                          data-item="<%= item.key %>"
                          data-role="<%= role.key %>"
                          <%= 'checked' if @policy.actions[item.key]?[role.key] %>
                        >
                        <span></span>
                      </label>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>

    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2><%- @T('Status Matrix') %></h2>
          <p><%- @T('Target statuses that each role may set directly on the job workflow.') %></p>
        </div>
      </div>

      <table class="dom-servis-dispatch-admin__matrix-table">
        <thead>
          <tr>
            <th><%- @T('Status') %></th>
            <th><%- @T('Master') %></th>
            <th><%- @T('Dispatcher') %></th>
            <th><%- @T('Admin') %></th>
          </tr>
        </thead>
        <tbody>
          <% for status in @registry.statuses: %>
            <tr>
              <td>
                <div class="dom-servis-dispatch-admin__cell-title"><%- @T(status.label) %></div>
                <div class="dom-servis-dispatch-admin__cell-hint"><%- @T(status.description) %></div>
              </td>
              <% for role in @registry.roles: %>
                <td class="dom-servis-dispatch-admin__toggle-cell">
                  <label class="dom-servis-dispatch-admin__toggle">
                    <input
                      class="js-policy-toggle"
                      type="checkbox"
                      data-section="statuses"
                      data-item="<%= status.key %>"
                      data-role="<%= role.key %>"
                      <%= 'checked' if @policy.statuses[status.key]?[role.key] %>
                    >
                    <span></span>
                  </label>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>

    <section class="dom-servis-dispatch-admin__section">
      <div class="dom-servis-dispatch-admin__section-head">
        <div>
          <h2><%- @T('Field Matrix') %></h2>
          <p><%- @T('Field registry is generated from dispatch job columns plus Dom-Servis virtual fields. New fields can be added without redesigning this screen.') %></p>
        </div>
      </div>

      <% for group in @registry.field_groups: %>
        <div class="dom-servis-dispatch-admin__matrix-block">
          <div class="dom-servis-dispatch-admin__matrix-title"><%- @T(group.label) %></div>
          <table class="dom-servis-dispatch-admin__matrix-table dom-servis-dispatch-admin__matrix-table--fields">
            <thead>
              <tr>
                <th rowspan="2"><%- @T('Field') %></th>
                <th colspan="2"><%- @T('Master') %></th>
                <th colspan="2"><%- @T('Dispatcher') %></th>
                <th colspan="2"><%- @T('Admin') %></th>
              </tr>
              <tr>
                <th><%- @T('Visible') %></th>
                <th><%- @T('Editable') %></th>
                <th><%- @T('Visible') %></th>
                <th><%- @T('Editable') %></th>
                <th><%- @T('Visible') %></th>
                <th><%- @T('Editable') %></th>
              </tr>
            </thead>
            <tbody>
              <% for field in group.items: %>
                <tr>
                  <td>
                    <div class="dom-servis-dispatch-admin__cell-title">
                      <%- @T(field.label) %>
                      <span class="dom-servis-dispatch-admin__badge"><%- @T(field.source) %></span>
                    </div>
                    <div class="dom-servis-dispatch-admin__cell-hint"><code><%= field.key %></code></div>
                  </td>
                  <% for role in @registry.roles: %>
                    <td class="dom-servis-dispatch-admin__toggle-cell">
                      <label class="dom-servis-dispatch-admin__toggle">
                        <input
                          class="js-policy-toggle"
                          type="checkbox"
                          data-section="fields"
                          data-item="<%= field.key %>"
                          data-role="<%= role.key %>"
                          data-mode="visible"
                          <%= 'checked' if @policy.fields[field.key]?[role.key]?.visible %>
                        >
                        <span></span>
                      </label>
                    </td>
                    <td class="dom-servis-dispatch-admin__toggle-cell">
                      <label class="dom-servis-dispatch-admin__toggle">
                        <input
                          class="js-policy-toggle"
                          type="checkbox"
                          data-section="fields"
                          data-item="<%= field.key %>"
                          data-role="<%= role.key %>"
                          data-mode="editable"
                          <%= 'checked' if @policy.fields[field.key]?[role.key]?.editable %>
                        >
                        <span></span>
                      </label>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
